# Copy to .env (next to compose.yaml) and replace the value. Never commit .env.
# InfluxDB admin token, used by the collector to write and by Grafana to read.
# It must start with "apiv3_", e.g.: echo "apiv3_$(openssl rand -hex 32)"
# InfluxDB only reads it on its first start: changing it later requires `influxdb3 create token --admin --regenerate`.
TCG_COLLECTOR_INFLUX_TOKEN=apiv3_change-me
