{
  "name": "tcg-collector",
  "version": "0.1.0",
  "private": true,
  "description": "Daily collection of Cardmarket public files (price guide and catalogues) for every game, archived as gzip and deduplicated by fingerprint.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "tcg-collector": "src/cli.ts"
  },
  "scripts": {
    "collect": "node src/cli.ts collect",
    "schedule": "node src/cli.ts schedule",
    "games": "node src/cli.ts games",
    "test": "node --test \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write src test web eslint.config.js",
    "format:check": "prettier --check src test web eslint.config.js",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "@influxdata/influxdb3-client": "^2.4.0",
    "chart.js": "^4.5.1",
    "commander": "^14.0.0",
    "hono": "^4.13.13",
    "ky": "^2.1.0",
    "minisearch": "^7.2.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.18.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.1"
  }
}
